# =================================================================
# Feedants Backend Environment Variables Template
# Copy this file to .env and provide your actual secrets/values
# =================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String (Atlas or local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/feedants_arena?retryWrites=true&w=majority

# CORS allowed origins (comma separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# JWT Authentication Secrets
JWT_ACCESS_SECRET=feedants_super_secret_access_jwt_key_32bytes_minimum
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=feedants_super_secret_refresh_jwt_key_32bytes_minimum
JWT_REFRESH_EXPIRATION=7d

# Razorpay Payment Gateway Credentials (Stub / Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
