# ==============================================================================
# FEEDANTS ARENA BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── Application Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Database (MongoDB Atlas or Local Replica Set) ──────────────────────────────
# NOTE: ACID transactions used in confirmRegistration require a MongoDB replica set.
# Atlas M0/M10+ clusters are always replica sets by default.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/feedants_arena?retryWrites=true&w=majority

# ── Caching & Ephemeral Store (Redis) ──────────────────────────────────────────
# Used for cache-aside reads on GET /api/competitions/:id.
# If Redis is unreachable, the system automatically falls back to an internal
# in-memory LRU store with zero downtime.
REDIS_URL=redis://127.0.0.1:6379

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use '*' in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006,https://arena-wog5.onrender.com

# ── Authentication & JWT Rotation ─────────────────────────────────────────────
# Rotation Strategy:
# 1. Access tokens are short-lived (15 minutes) to minimize token compromise blast radius.
# 2. Refresh tokens are long-lived (7 days) and stored securely in database/Keychain.
# 3. For key rotation, support dual-key verification (CURRENT_KEY and PREVIOUS_KEY)
#    during a 24-hour transition window before invalidating the old key.
JWT_ACCESS_SECRET=feedants_super_secret_access_jwt_key_32bytes_minimum_arena
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=feedants_super_secret_refresh_jwt_key_32bytes_minimum_arena
JWT_REFRESH_EXPIRATION=7d

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Use Test Mode keys for local and staging environments
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
# Secret configured in Razorpay Dashboard > Settings > Webhooks for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_arena_feedants
