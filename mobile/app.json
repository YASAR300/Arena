{
  "expo": {
    "name": "Feedants",
    "slug": "feedants-arena",
    "scheme": "feedants",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.feedants.arena",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#005F60"
      }
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-video",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7208ef89-df73-4f3f-a940-a027de9752c3"
      }
    }
  }
}
