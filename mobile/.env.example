# =================================================================
# Feedants Mobile (Expo) Environment Variables Template
# Copy this file to .env and provide your actual values
# Expo reads EXPO_PUBLIC_* variables at build time (not secret)
# =================================================================

# API Base URL for backend REST server
# Android Emulator: http://10.0.2.2:5000/api/v1
# iOS Simulator / Web: http://localhost:5000/api/v1
# Staging / Production: https://api.feedants.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# App environment identifier
EXPO_PUBLIC_ENV=development
